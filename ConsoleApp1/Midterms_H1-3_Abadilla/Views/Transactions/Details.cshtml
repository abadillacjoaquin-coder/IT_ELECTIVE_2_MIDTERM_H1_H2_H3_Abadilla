@model Midterms_H1_3_Abadilla.Models.Domain.Transaction
@{
    ViewData["Title"] = "Transaction #" + Model.Id;
}

<div class="card shadow-sm col-lg-8 mx-auto">
    <div class="card-header bg-success text-white">
        <h3>Transaction Receipt #@Model.Id</h3>
    </div>
    <div class="card-body">
        <p><strong>Customer:</strong> @Model.CustomerName</p>
        <p><strong>Email:</strong> @(string.IsNullOrEmpty(Model.CustomerEmail) ? "N/A" : Model.CustomerEmail)</p>
        <p><strong>Date:</strong> @Model.TransactionDate.ToString("f")</p>

        <hr />
        <h5>Purchased Items</h5>
        <table class="table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>$@item.UnitPrice.ToString("F2")</td>
                        <td>@item.Quantity</td>
                        <td>$@item.LineTotal.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="text-end text-success mt-3">Grand Total: $@Model.TotalAmount.ToString("F2")</h4>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-secondary mt-3">Back to Catalog</a>
    </div>
</div>