@model IEnumerable<Midterms_H1_3_Abadilla.Models.Domain.Transaction>
@{
    ViewData["Title"] = "Transaction History";
}

<h2 class="mb-4">Transaction History</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No transactions recorded yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Transaction ID</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>#@t.Id</td>
                    <td>@t.CustomerName</td>
                    <td>@t.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="fw-bold">$@t.TotalAmount.ToString("F2")</td>
                    <td>
                        <a asp-controller="Transactions" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}