@model PosWebApp.Models.Domain.ShoppingCart
@{
    ViewData["Title"] = "Shopping Cart";
    var checkoutDto = ViewBag.CheckoutDto as PosWebApp.Models.DTOs.CheckoutDto ?? new PosWebApp.Models.DTOs.CheckoutDto();
}

<h2 class="mb-4">Active Shopping Cart</h2>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info p-4 text-center">
        <h4>The cart is currently empty.</h4>
        <p>Return to the product catalog to begin adding items for checkout.</p>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-amber">Browse Products</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Unit Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-bold">@item.ProductName</td>
                                    <td>$@item.UnitPrice.ToString("F2")</td>
                                    <td style="width: 140px;">
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="ProductId" value="@item.ProductId" />
                                            <input type="number" name="Quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                        </form>
                                    </td>
                                    <td class="fw-bold">$@item.LineTotal.ToString("F2")</td>
                                    <td>
                                        <form asp-controller="Cart" asp-action="Remove" method="post">
                                            <input type="hidden" name="ProductId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-amber">
                <div class="card-header bg-amber text-white fw-bold">Checkout & Payment</div>
                <div class="card-body">
                    <h3 class="d-flex justify-content-between mb-4">
                        <span>Grand Total:</span>
                        <span class="text-amber">$@Model.GrandTotal.ToString("F2")</span>
                    </h3>

                    <form asp-controller="Cart" asp-action="Checkout" method="post">
                        <div class="mb-3">
                            <label class="form-label" for="CustomerName">Customer Name *</label>
                            <input type="text" id="CustomerName" name="CustomerName" value="@checkoutDto.CustomerName" class="form-control" />
                            <span class="text-danger" data-valmsg-for="CustomerName"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="CustomerEmail">Customer Email</label>
                            <input type="email" id="CustomerEmail" name="CustomerEmail" value="@checkoutDto.CustomerEmail" class="form-control" />
                            <span class="text-danger" data-valmsg-for="CustomerEmail"></span>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100">Complete Purchase</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}