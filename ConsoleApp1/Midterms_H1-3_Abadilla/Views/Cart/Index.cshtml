@model Midterms_H1_3_Abadilla.Models.Domain.ShoppingCart
@{
    ViewData["Title"] = "Shopping Cart";
    var items = Model?.Items ?? new List<Midterms_H1_3_Abadilla.Models.Domain.CartItem>();
    var checkoutDto = ViewBag.CheckoutDto as Midterms_H1_3_Abadilla.Models.DTOs.CheckoutDto ?? new Midterms_H1_3_Abadilla.Models.DTOs.CheckoutDto();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Active Shopping Cart</h3>
        <p class="text-muted small mb-0">Review your chosen items and proceed to customer checkout.</p>
    </div>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary rounded-3 btn-sm px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Catalog
    </a>
</div>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (!items.Any())
{
    <div class="card p-5 text-center my-4">
        <div class="card-body">
            <div class="mb-3 text-muted display-4">
                <i class="bi bi-cart-x"></i>
            </div>
            <h4 class="fw-semibold text-dark">Your cart is currently empty</h4>
            <p class="text-muted max-w-sm mx-auto mb-4">Explore our catalog to add items before checking out.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-3 font-medium">
                <i class="bi bi-bag-plus me-1"></i> Browse Products
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Cart Items List -->
        <div class="col-lg-8">
            <div class="card p-3">
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <thead class="border-bottom text-muted small text-uppercase">
                            <tr>
                                <th scope="col" class="py-3">Product</th>
                                <th scope="col" class="py-3 text-center">Unit Price</th>
                                <th scope="col" class="py-3 text-center" style="width: 140px;">Quantity</th>
                                <th scope="col" class="py-3 text-end">Subtotal</th>
                                <th scope="col" class="py-3 text-center" style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr class="border-bottom">
                                    <td class="py-3">
                                        <div class="fw-semibold text-dark">@item.ProductName</div>
                                        <small class="text-muted">ID: #@item.ProductId</small>
                                    </td>
                                    <td class="py-3 text-center">$@item.UnitPrice.ToString("F2")</td>
                                    <td class="py-3 text-center">
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1">
                                            <input type="hidden" name="ProductId" value="@item.ProductId" />
                                            <input type="number" name="Quantity" value="@item.Quantity" min="1" class="form-control form-control-sm text-center rounded-2" />
                                            <button type="submit" class="btn btn-sm btn-light border rounded-2" title="Update">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="py-3 text-end fw-bold text-dark">$@item.LineTotal.ToString("F2")</td>
                                    <td class="py-3 text-center">
                                        <form asp-controller="Cart" asp-action="Remove" method="post">
                                            <input type="hidden" name="ProductId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm text-danger btn-link p-0" title="Remove Item">
                                                <i class="bi bi-trash fs-5"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Checkout Card -->
        <div class="col-lg-4">
            <div class="card p-4">
                <h5 class="fw-bold mb-3 text-dark">Order Summary</h5>
                <hr class="my-2" />
                <div class="d-flex justify-content-between align-items-center my-3">
                    <span class="text-muted">Total Payable</span>
                    <span class="fs-3 fw-bold text-primary">$@((Model?.GrandTotal ?? 0).ToString("F2"))</span>
                </div>

                <form asp-controller="Cart" asp-action="Checkout" method="post" class="mt-2">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary" for="CustomerName">Customer Name *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                            <input type="text" id="CustomerName" name="CustomerName" value="@checkoutDto.CustomerName" class="form-control border-start-0" placeholder="John Doe" />
                        </div>
                        <span class="text-danger small" data-valmsg-for="CustomerName"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary" for="CustomerEmail">Customer Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                            <input type="email" id="CustomerEmail" name="CustomerEmail" value="@checkoutDto.CustomerEmail" class="form-control border-start-0" placeholder="john@example.com" />
                        </div>
                        <span class="text-danger small" data-valmsg-for="CustomerEmail"></span>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-semibold">
                        Complete Checkout <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
}